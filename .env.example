# Jewelry Description Application - Environment Variables Template
# Copy this file to .env and fill in your values

# ==========================================
# APPLICATION SETTINGS
# ==========================================

# Application environment (development, testing, staging, production)
JEWELRY_ENVIRONMENT=development

# Application name and version
JEWELRY_APP_NAME=jewelry-description
JEWELRY_VERSION=0.1.0

# Debug mode (true for development, false for production)
JEWELRY_DEBUG=true

# ==========================================
# WEB SERVER SETTINGS
# ==========================================

# Web server host and port
JEWELRY_WEB_HOST=localhost
JEWELRY_WEB_PORT=8000

# CORS allowed origins (JSON array for multiple)
JEWELRY_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# ==========================================
# DATABASE SETTINGS
# ==========================================

# Database connection URL
# For development: sqlite+aiosqlite:///./jewelry.db
# For production: postgresql+asyncpg://user:password@host:port/database
JEWELRY_DATABASE_URL=sqlite+aiosqlite:///./jewelry.db

# ==========================================
# SECURITY SETTINGS
# ==========================================

# Secret key for JWT tokens and sessions (CHANGE THIS IN PRODUCTION!)
# Generate a secure random key: openssl rand -hex 32
JEWELRY_SECRET_KEY=changeme-secret-key-for-development-only

# ==========================================
# LOGGING SETTINGS
# ==========================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
JEWELRY_LOG_LEVEL=DEBUG

# Log format string
JEWELRY_LOG_FORMAT=%(asctime)s | %(levelname)s | %(name)s:%(funcName)s:%(lineno)d - %(message)s

# ==========================================
# API SETTINGS
# ==========================================

# API prefix for endpoints
JEWELRY_API_PREFIX=/api/v1

# API documentation settings
JEWELRY_API_TITLE=Jewelry Description API
JEWELRY_API_DESCRIPTION=API for jewelry cost calculation and description generation
JEWELRY_API_VERSION=v1

# ==========================================
# RATE LIMITING
# ==========================================

# Rate limit: requests per window
JEWELRY_RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds
JEWELRY_RATE_LIMIT_WINDOW=60

# ==========================================
# FILE UPLOAD SETTINGS
# ==========================================

# Maximum file upload size in bytes (default: 10MB)
JEWELRY_MAX_UPLOAD_SIZE=10485760

# Allowed file extensions for upload (JSON array)
JEWELRY_ALLOWED_EXTENSIONS=[".csv",".json"]

# ==========================================
# CACHE SETTINGS
# ==========================================

# Enable caching
JEWELRY_CACHE_ENABLED=true

# Cache TTL in seconds
JEWELRY_CACHE_TTL=300

# ==========================================
# EXTERNAL SERVICES
# ==========================================

# External API timeout in seconds
JEWELRY_EXTERNAL_API_TIMEOUT=30

# External API retry attempts
JEWELRY_EXTERNAL_API_RETRIES=3

# ==========================================
# PRODUCTION-ONLY SETTINGS
# ==========================================
# These settings are only required in production/staging environments

# Production database URL (required in production)
# JEWELRY_DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Production secret key (required in production, min 64 characters)
# JEWELRY_SECRET_KEY=your-very-secure-production-secret-key-here

# Production CORS origins (HTTPS only in production)
# JEWELRY_CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ==========================================
# MONITORING AND METRICS
# ==========================================

# Enable monitoring (production/staging only)
# JEWELRY_MONITORING_ENABLED=true

# Enable metrics collection
# JEWELRY_METRICS_ENABLED=true

# Enable health checks
# JEWELRY_HEALTH_CHECKS_ENABLED=true

# ==========================================
# SECURITY HEADERS
# ==========================================

# Enable security headers (production only)
# JEWELRY_SECURITY_HEADERS_ENABLED=true

# Enable HSTS (production only)
# JEWELRY_HSTS_ENABLED=true

# Enable CSP (production only)
# JEWELRY_CSP_ENABLED=true

# ==========================================
# PERFORMANCE SETTINGS
# ==========================================

# Database connection pool size
# JEWELRY_CONNECTION_POOL_SIZE=10

# Maximum database connections
# JEWELRY_MAX_CONNECTIONS=100